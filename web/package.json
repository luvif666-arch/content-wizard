{
  "name": "content-wizard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "内容创作向导：把一篇文章的思维过程固化成 6 步流程，输出可直接交给 AI Agent 的创作简报",
  "scripts": {
    "dev": "vite --port 5233 --strictPort",
    "build": "vite build --base=./",
    "preview": "vite preview --port 5234 --strictPort",
    "typecheck": "tsc --noEmit",
    "serve": "node serve-dist.mjs 5240",
    "verify": "node verify.mjs http://127.0.0.1:5240/"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
